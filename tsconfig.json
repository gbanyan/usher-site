{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "*.ts"],
  "exclude": ["dist", "node_modules", "content-snapshots", "hugo-archive"],
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
