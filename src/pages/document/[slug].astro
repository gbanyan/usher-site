---
import { mapWithConcurrency } from "../../lib/concurrency";
import { safeUrl } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getAllPublicDocumentSlugs, getPublicDocument } from "../../lib/api";
import { buildPageMetadata } from "../../lib/metadata";
import { getWebPageSchema } from "../../lib/jsonld";
import { getDocumentUpdatedAt } from "../../lib/transform";
import { formatDate } from "../../lib/utils";
import { toRoutePath } from "../../lib/nav";
import type { PublicDocumentDetailResponse } from "../../lib/types";

export async function getStaticPaths() {
  const slugs = await getAllPublicDocumentSlugs();
  return mapWithConcurrency(slugs, 8, async (slug) => {
    const { data, related } = await getPublicDocument(slug);
    return { params: { slug }, props: { document: data, related: related ?? [] } };
  });
}

interface Props {
  document: PublicDocumentDetailResponse["data"];
  related: NonNullable<PublicDocumentDetailResponse["related"]>;
}

const { document, related } = Astro.props;
const pathname = toRoutePath(Astro.url.pathname);
const updatedAt = getDocumentUpdatedAt(document);
const description = document.summary || document.description || "協會公開文件與下載";
const hashPreview = (hash: string | null | undefined) => (hash ? `${hash.slice(0, 16)}...` : null);
const BTN = "inline-flex items-center rounded-md border border-white/20 px-3 py-1.5 text-xs font-medium text-gray-200 hover:bg-white/10";
---

<BaseLayout
  meta={buildPageMetadata(document.title, description, pathname, {})}
  jsonLd={getWebPageSchema(document.title, description, pathname)}
>
  <div data-pagefind-body>
    <PageHeader
      title={document.title}
      items={[{ label: "協會文件", href: "/document" }, { label: document.title }]}
      description={updatedAt ? `更新：${formatDate(updatedAt)}` : undefined}
    />

    <article class="mx-auto max-w-5xl px-6 py-12 lg:px-8">
      <section class="rounded-xl border border-white/15 bg-primary-dark/70 p-6 shadow-sm shadow-black/20">
        <div class="flex flex-wrap items-center gap-2">
          {
            document.category && (
              <span class="rounded-full bg-accent/15 px-3 py-1 text-xs font-medium text-accent-light">
                {document.category.name}
              </span>
            )
          }
          <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-gray-200">{document.access_level_label}</span>
          <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-gray-200">{document.status_label}</span>
        </div>

        <dl class="mt-4 grid grid-cols-1 gap-3 text-sm text-gray-200 sm:grid-cols-2">
          <div>
            <dt class="text-gray-400">文號</dt>
            <dd class="mt-1">{document.document_number ?? "未提供"}</dd>
          </div>
          <div>
            <dt class="text-gray-400">目前版本</dt>
            <dd class="mt-1">{document.current_version?.version_number ?? "未設定"}</dd>
          </div>
          <div>
            <dt class="text-gray-400">最近更新</dt>
            <dd class="mt-1">{updatedAt ? formatDate(updatedAt) : "未設定"}</dd>
          </div>
          <div>
            <dt class="text-gray-400">有效期限</dt>
            <dd class="mt-1">{document.expires_at ? formatDate(document.expires_at) : "無期限"}</dd>
          </div>
        </dl>

        {document.description && <p class="mt-5 text-sm leading-relaxed text-gray-300">{document.description}</p>}

        <div class="mt-6 flex flex-wrap gap-2">
          {
            document.current_version?.download_url && (
              <a
                href={safeUrl(document.current_version.download_url) || undefined}
                aria-label={`下載「${document.title}」目前版本：${document.current_version.original_filename}`}
                class="inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-primary-dark hover:bg-accent-light"
              >
                下載目前版本
              </a>
            )
          }
        </div>
      </section>

      <section class="mt-8 rounded-xl border border-white/15 bg-primary-dark/70 p-6 shadow-sm shadow-black/20" aria-labelledby="versions-heading">
        <h2 id="versions-heading" class="text-xl font-semibold text-white">版本資訊</h2>

        {
          document.versions.length > 0 ? (
            <>
              <div class="mt-4 hidden overflow-hidden rounded-lg border border-white/10 md:block">
                <table class="min-w-full divide-y divide-white/10">
                  <caption class="sr-only">文件版本歷程</caption>
                  <thead class="bg-primary/50">
                    <tr>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">版本</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">檔案</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">更新日期</th>
                      <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">雜湊</th>
                      <th class="px-4 py-3 text-right text-xs font-semibold text-gray-200">下載</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/10">
                    {document.versions.map((version) => (
                      <tr>
                        <td class="px-4 py-3 text-sm text-gray-100">
                          {version.version_number}
                          {version.is_current && (
                            <span class="ml-2 rounded bg-green-700/60 px-2 py-0.5 text-xs text-green-100">最新</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-200">
                          <p class="break-all">{version.original_filename}</p>
                          <p class="mt-1 text-xs text-gray-400">{version.file_size_human}</p>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-200">
                          {version.uploaded_at ? formatDate(version.uploaded_at) : "未設定"}
                        </td>
                        <td class="px-4 py-3 text-xs text-gray-300">{hashPreview(version.file_hash) ?? "-"}</td>
                        <td class="px-4 py-3 text-right">
                          <a
                            href={safeUrl(version.download_url) || undefined}
                            aria-label={`下載版本 ${version.version_number}：${version.original_filename}`}
                            class={BTN}
                          >
                            下載
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <ul class="mt-4 space-y-3 md:hidden" aria-label="文件版本歷程">
                {document.versions.map((version) => (
                  <li class="rounded-lg border border-white/10 bg-primary/30 p-4">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-semibold text-white">版本 {version.version_number}</span>
                      {version.is_current && (
                        <span class="rounded bg-green-700/60 px-2 py-0.5 text-xs text-green-100">最新</span>
                      )}
                    </div>
                    <p class="mt-2 break-all text-sm text-gray-200">{version.original_filename}</p>
                    <dl class="mt-2 grid grid-cols-1 gap-1 text-xs text-gray-400">
                      <div>
                        <dt class="sr-only">檔案大小</dt>
                        <dd>{version.file_size_human}</dd>
                      </div>
                      <div>
                        <dt class="sr-only">更新日期</dt>
                        <dd>{version.uploaded_at ? formatDate(version.uploaded_at) : "未設定"}</dd>
                      </div>
                      {version.file_hash && (
                        <div>
                          <dt class="sr-only">雜湊</dt>
                          <dd class="font-mono">{hashPreview(version.file_hash)}</dd>
                        </div>
                      )}
                    </dl>
                    <div class="mt-3">
                      <a
                        href={safeUrl(version.download_url) || undefined}
                        aria-label={`下載版本 ${version.version_number}：${version.original_filename}`}
                        class={BTN}
                      >
                        下載
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p class="mt-4 text-sm text-gray-300">目前沒有版本資料。</p>
          )
        }
      </section>

      {
        related.length > 0 && (
          <section
            class="mt-8 rounded-xl border border-white/15 bg-primary-dark/70 p-6 shadow-sm shadow-black/20"
            aria-labelledby="related-heading"
            data-pagefind-ignore
          >
            <h2 id="related-heading" class="text-xl font-semibold text-white">相關文件</h2>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {related.map((item) => (
                <li class="rounded-lg border border-white/15 bg-primary/30 p-4">
                  <a href={`/document/${item.slug}`} class="text-sm font-semibold text-white hover:text-accent">
                    {item.title}
                  </a>
                  <p class="mt-2 text-xs text-gray-300">{item.category?.name ?? "未分類"}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>

  <nav class="mx-auto max-w-5xl px-6 pb-12 lg:px-8" data-pagefind-ignore>
    <a href="/document" class="inline-flex items-center text-sm font-medium text-accent transition-colors hover:text-accent-light">
      <span aria-hidden="true">&larr;</span>
      <span class="ml-2">返回協會文件列表</span>
    </a>
  </nav>
</BaseLayout>
