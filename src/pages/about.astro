---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Markdown from "../components/Markdown.astro";
import { getAllPublicDocuments, getOrganizationProfile, getPage } from "../lib/api";
import { buildPageMetadata } from "../lib/metadata";
import { GOVERNANCE_DOCUMENTS, findGovernanceDocuments } from "../lib/governance";
import { getDocumentUpdatedAt } from "../lib/transform";
import { formatDate } from "../lib/utils";

const [page, documents, organization] = await Promise.all([
  getPage("about"),
  getAllPublicDocuments(),
  getOrganizationProfile(),
]);

const title = page.title || "創立目的";
const description = page.meta_description || "台灣尤塞氏症暨視聽弱協會的創立目的與宗旨";

const governanceDocuments = findGovernanceDocuments(documents);
const governanceRows = GOVERNANCE_DOCUMENTS.map((item) => {
  const document = governanceDocuments[item.key] ?? null;
  const hash = document?.current_version?.file_hash;
  const updatedAt = getDocumentUpdatedAt(document);
  return {
    ...item,
    document,
    hash: hash ? `${hash.slice(0, 16)}...` : null,
    updatedLabel: updatedAt ? formatDate(updatedAt) : null,
  };
});

const incorporationLetter = governanceDocuments["letter"] ?? null;
const registrationCertificate = governanceDocuments["registration"] ?? null;
const DOWNLOAD_BTN = "inline-flex items-center rounded-md border border-white/20 px-3 py-1.5 text-xs font-medium text-gray-200 hover:bg-white/10";
---

<BaseLayout meta={buildPageMetadata(title, description, "/about", { keywords: page.meta_keywords || undefined })}>
  <div data-pagefind-body>
    <PageHeader title={page.title} items={[{ label: "創立目的" }]} />

    <article class="mx-auto max-w-4xl px-6 py-12 lg:px-8">
      <Markdown content={page.content} />

      <section class="mt-12 rounded-xl border border-white/10 bg-primary/40 p-6 shadow-sm" aria-labelledby="governance-heading">
        <h2 id="governance-heading" class="text-2xl font-semibold text-white">合法設立與治理</h2>
        <p class="mt-2 text-sm leading-relaxed text-gray-300">
          本會依法完成立案與法人登記，並持續公開章程與立案文件版本資訊，供外部單位、合作夥伴及大眾查核。
        </p>

        <dl class="mt-5 grid grid-cols-1 gap-3 text-sm text-gray-200 sm:grid-cols-2">
          <div class="rounded-lg border border-white/10 bg-primary-dark/70 px-4 py-3">
            <dt class="text-gray-400">統一編號</dt>
            <dd class="mt-1 font-medium text-white">{organization.tax_id}</dd>
          </div>
          <div class="rounded-lg border border-white/10 bg-primary-dark/70 px-4 py-3">
            <dt class="text-gray-400">立案機關</dt>
            <dd class="mt-1 font-medium text-white">內政部</dd>
          </div>
          <div class="rounded-lg border border-white/10 bg-primary-dark/70 px-4 py-3">
            <dt class="text-gray-400">立案函文號</dt>
            <dd class="mt-1 font-medium text-white">{incorporationLetter?.document_number ?? "請參閱下方文件"}</dd>
          </div>
          <div class="rounded-lg border border-white/10 bg-primary-dark/70 px-4 py-3">
            <dt class="text-gray-400">法人登記文號</dt>
            <dd class="mt-1 font-medium text-white">{registrationCertificate?.document_number ?? "請參閱下方文件"}</dd>
          </div>
        </dl>

        <div class="mt-6 hidden overflow-hidden rounded-lg border border-white/10 md:block">
          <table class="min-w-full divide-y divide-white/10">
            <caption class="sr-only">協會合法設立與治理文件清單</caption>
            <thead class="bg-primary-dark/70">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">文件</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">用途</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">版本</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">最近更新</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-200">檔案雜湊</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-200">下載</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              {
                governanceRows.map((row) => (
                  <tr>
                    <td class="px-4 py-3 text-sm text-white">
                      {row.document ? (
                        <a href={`/document/${row.document.slug}`} class="font-medium text-accent hover:text-accent-light">
                          {row.document.title}
                        </a>
                      ) : (
                        <span>{row.title}</span>
                      )}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-300">{row.purpose}</td>
                    <td class="px-4 py-3 text-sm text-gray-200">{row.document?.current_version?.version_number ?? "未同步"}</td>
                    <td class="px-4 py-3 text-sm text-gray-200">{row.updatedLabel ?? "未同步"}</td>
                    <td class="px-4 py-3 text-xs text-gray-300">{row.hash ?? "未提供"}</td>
                    <td class="px-4 py-3 text-right">
                      {row.document?.links.download_url ? (
                        <a href={row.document.links.download_url} aria-label={`下載「${row.document.title}」`} class={DOWNLOAD_BTN}>
                          下載
                        </a>
                      ) : (
                        <span class="text-xs text-gray-400">未提供</span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <ul class="mt-6 space-y-4 md:hidden" aria-label="協會合法設立與治理文件清單">
          {
            governanceRows.map((row) => (
              <li class="rounded-lg border border-white/10 bg-primary-dark/50 p-4">
                <h3 class="text-base font-semibold text-white">
                  {row.document ? (
                    <a href={`/document/${row.document.slug}`} class="hover:text-accent">
                      {row.document.title}
                    </a>
                  ) : (
                    row.title
                  )}
                </h3>
                <p class="mt-1 text-sm text-gray-300">{row.purpose}</p>
                <dl class="mt-3 grid grid-cols-1 gap-1 text-sm text-gray-200">
                  <div>
                    <dt class="sr-only">版本</dt>
                    <dd>{row.document?.current_version?.version_number ?? "未同步"}</dd>
                  </div>
                  <div>
                    <dt class="sr-only">最近更新</dt>
                    <dd>{row.updatedLabel ?? "未同步"}</dd>
                  </div>
                  {row.hash && (
                    <div>
                      <dt class="sr-only">檔案雜湊</dt>
                      <dd class="font-mono text-xs text-gray-400">{row.hash}</dd>
                    </div>
                  )}
                </dl>
                <div class="mt-4">
                  {row.document?.links.download_url ? (
                    <a href={row.document.links.download_url} aria-label={`下載「${row.document.title}」`} class={DOWNLOAD_BTN}>
                      下載
                    </a>
                  ) : (
                    <span class="text-xs text-gray-400">未提供</span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      {
        page.children.length > 0 && (
          <nav class="mt-16 border-t border-gray-200 pt-10" data-pagefind-ignore>
            <h2 class="mb-6 text-xl font-semibold text-white">相關頁面</h2>
            <ul class="grid gap-4 sm:grid-cols-2">
              {page.children.map((child) => (
                <li>
                  <a
                    href={`/${child.slug}`}
                    class="block rounded-lg border border-white/10 p-5 transition-colors hover:border-accent hover:bg-primary/20"
                  >
                    <span class="font-medium text-accent">{child.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>
