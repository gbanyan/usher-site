---
// Server-rendered shell with persistent live region and controls container;
// PaginatedGrid's script only updates the status text and the buttons.
// Without JavaScript the nav stays hidden and every card is visible.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<nav aria-label={label} data-pagination-nav hidden class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-sm text-gray-300" aria-live="polite" data-pagination-status></p>
  <div class="flex flex-wrap items-center gap-1.5" data-pagination-controls></div>
</nav>
