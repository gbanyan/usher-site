---
import type { ArticleSummary } from "../lib/types";
import PaginatedGrid from "./PaginatedGrid.astro";

interface Props {
  articles: ArticleSummary[];
  emptyText: string;
  basePath?: string;
}

const { articles, emptyText, basePath } = Astro.props;
---

{
  articles.length === 0 ? (
    <div class="rounded-xl border border-dashed border-white/20 bg-primary/40 px-6 py-12 text-center" role="status">
      <p class="text-base font-medium text-white">{emptyText}</p>
      <p class="mt-2 text-sm text-gray-300">可稍後再查看，或直接聯絡協會洽詢。</p>
      <div class="mt-4">
        <a href="/contact" class="inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-primary-dark hover:bg-accent-light">
          聯絡協會
        </a>
      </div>
    </div>
  ) : (
    <PaginatedGrid articles={articles} basePath={basePath} />
  )
}
