---
import PaginationControls from "./PaginationControls.astro";
import { formatDate } from "../lib/utils";
import { getDocumentUpdatedAt } from "../lib/transform";
import type { PublicDocumentSummary } from "../lib/types";

interface Props {
  documents: PublicDocumentSummary[];
}

const PAGE_SIZE = 10;
const { documents } = Astro.props;
---

<div data-doc-list data-page-size={PAGE_SIZE}>
  <div class="hidden overflow-hidden rounded-xl border border-white/15 bg-primary-dark/70 shadow-sm shadow-black/20 md:block">
    <table class="min-w-full divide-y divide-white/10">
      <caption class="sr-only">協會文件公開資源列表</caption>
      <thead class="bg-primary/60">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-200">文件</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-200">分類與文號</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-200">版本與更新</th>
          <th scope="col" class="min-w-[10rem] px-6 py-3 text-right text-xs font-semibold text-gray-200">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/10" data-doc-rows>
        {
          documents.map((document) => {
            const detailUrl = `/document/${document.slug}`;
            const updatedAt = getDocumentUpdatedAt(document);
            return (
              <tr class="align-top hover:bg-white/5">
                <td class="px-6 py-4">
                  <div>
                    <a href={detailUrl} class="text-base font-semibold text-white hover:text-accent">
                      {document.title}
                    </a>
                    {document.description && (
                      <p class="mt-1 line-clamp-2 text-sm text-gray-300">{document.description}</p>
                    )}
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-200">
                  <div class="flex flex-wrap gap-1.5">
                    {document.category && (
                      <span class="rounded-full bg-accent/15 px-2 py-0.5 text-xs font-medium text-accent-light">
                        {document.category.name}
                      </span>
                    )}
                    <span class="rounded-full border border-white/20 px-2 py-0.5 text-xs text-gray-300">
                      {document.access_level_label}
                    </span>
                  </div>
                  {document.document_number && (
                    <p class="mt-2 text-xs text-gray-300">文號：{document.document_number}</p>
                  )}
                </td>
                <td class="px-6 py-4 text-sm text-gray-200">
                  <p>版本：{document.current_version?.version_number ?? "-"}</p>
                  <p class="mt-1 text-xs text-gray-400">更新：{updatedAt ? formatDate(updatedAt) : "未設定"}</p>
                  <p class="mt-1 text-xs text-gray-400">檔案：{document.current_version?.file_size_human ?? "-"}</p>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-nowrap justify-end gap-2">
                    <a
                      href={detailUrl}
                      class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md bg-accent px-3 py-1.5 text-xs font-medium text-primary-dark hover:bg-accent-light"
                    >
                      查看詳情
                    </a>
                    {document.links.download_url && (
                      <a
                        href={document.links.download_url}
                        aria-label={`下載「${document.title}」`}
                        class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md border border-white/20 px-3 py-1.5 text-xs font-medium text-gray-200 hover:bg-white/10"
                      >
                        下載
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <ul class="space-y-4 md:hidden" data-doc-cards>
    {
      documents.map((document) => {
        const detailUrl = `/document/${document.slug}`;
        const updatedAt = getDocumentUpdatedAt(document);
        return (
          <li class="rounded-xl border border-white/15 bg-primary-dark/70 p-4 shadow-sm shadow-black/20">
            <h3 class="text-balance text-base font-semibold text-white">
              <a href={detailUrl} class="hover:text-accent">
                {document.title}
              </a>
            </h3>
            {document.description && (
              <p class="mt-2 line-clamp-3 text-pretty text-sm text-gray-300">{document.description}</p>
            )}
            <dl class="mt-3 grid grid-cols-1 gap-1 text-sm text-gray-200">
              <div>
                <dt class="sr-only">分類</dt>
                <dd>分類：{document.category?.name ?? "未分類"}</dd>
              </div>
              <div>
                <dt class="sr-only">版本</dt>
                <dd>版本：{document.current_version?.version_number ?? "-"}</dd>
              </div>
              <div>
                <dt class="sr-only">更新</dt>
                <dd>更新：{updatedAt ? formatDate(updatedAt) : "未設定"}</dd>
              </div>
            </dl>
            <div class="mt-4 flex flex-nowrap gap-2">
              <a
                href={detailUrl}
                class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md bg-accent px-3 py-1.5 text-xs font-medium text-primary-dark hover:bg-accent-light"
              >
                查看詳情
              </a>
              {document.links.download_url && (
                <a
                  href={document.links.download_url}
                  aria-label={`下載「${document.title}」`}
                  class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md border border-white/20 px-3 py-1.5 text-xs font-medium text-gray-200 hover:bg-white/10"
                >
                  下載
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>

  <PaginationControls label="協會文件列表分頁" />
</div>

<script>
  import { initPagination } from "../lib/paginated-dom";

  document.querySelectorAll<HTMLElement>("[data-doc-list]").forEach((root) => {
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-doc-rows] > tr"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-doc-cards] > li"));
    initPagination(root, [rows, cards]);
  });
</script>
