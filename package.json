{
  "name": "usher-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npx pagefind --site .next && rm -rf public/_pagefind && cp -r .next/pagefind public/_pagefind",
    "start": "next start",
    "test": "vitest run",
    "check:content": "node scripts/check-markdown.mjs",
    "check:assets": "node scripts/check-content-assets.mjs",
    "check:a11y": "node scripts/check-a11y-static.mjs",
    "lint": "eslint",
    "snapshot": "node scripts/snapshot-content.mjs",
    "refresh:content": "npm run snapshot && npm run check:content && npm run check:assets",
    "subset-logo-font": "node scripts/subset-logo-font.mjs",
    "extract-logo-icon": "node scripts/extract-logo-icon.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swiper": "14.1.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "pagefind": "1.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
