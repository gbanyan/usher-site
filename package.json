{
  "name": "usher-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "test": "vitest run",
    "check:content": "node scripts/check-markdown.mjs",
    "check:assets": "node scripts/check-content-assets.mjs",
    "check:a11y": "node scripts/check-a11y-static.mjs",
    "lint": "astro check && eslint .",
    "snapshot": "node scripts/snapshot-content.mjs",
    "refresh:content": "npm run snapshot && npm run check:content && npm run check:assets",
    "subset-logo-font": "node scripts/subset-logo-font.mjs",
    "extract-logo-icon": "node scripts/extract-logo-icon.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "clsx": "^2.1.1",
    "hast-util-to-string": "^3.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "1.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  }
}
