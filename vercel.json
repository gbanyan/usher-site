{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog", "destination": "/news", "permanent": true },
    { "source": "/notice", "destination": "/news", "permanent": true },
    { "source": "/message", "destination": "/about", "permanent": true },
    { "source": "/research", "destination": "/document", "permanent": true },
    { "source": "/logo_represent", "destination": "/logo-represent", "permanent": true }
  ]
}
